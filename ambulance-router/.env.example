# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SPEED_KEY=traffic:speeds

# SUMO
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo
SUMO_NET_FILE=data/city.net.xml
SUMO_CONFIG_FILE=simulation/city.sumocfg
SUMO_BINARY_NAME=sumo

# Data files
HOSPITALS_FILE=data/hospitals.json
FALLBACK_FILE=fallback/fallback_traffic.json

# Routing
ALPHA_EMERGENCY_DEFAULT=1.0

# Daemons
SIMULATION_STEP_SLEEP_SECONDS=1.0
FALLBACK_SAVE_INTERVAL_SECONDS=5
REDIS_RECONNECT_BACKOFF_SECONDS=2